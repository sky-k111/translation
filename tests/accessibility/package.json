{
  "name": "word-drawer-accessibility-tests",
  "version": "1.0.0",
  "description": "Lighthouse accessibility tests for WordDrawerV2 component",
  "private": true,
  "scripts": {
    "lighthouse": "node run-lighthouse.js",
    "lighthouse:open": "node run-lighthouse.js && open reports/lighthouse-*.html",
    "serve": "npx http-server ../.. -p 8080 -o tests/accessibility/lighthouse-test.html"
  },
  "dependencies": {
    "chrome-launcher": "^1.1.0",
    "lighthouse": "^11.4.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
